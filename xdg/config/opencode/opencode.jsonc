{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "execute": false
  },
  "model": "v2noop/root-noop",
  "default_agent": "transport-root",
  "provider": {
    "syv": {
      "name": "SYV Qwen3.8-27B RTX3090 MTP",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:18033/v1",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "qwen38": {
          "id": "qwen3.8-27b",
          "name": "Qwen3.8-27B SYV MTP",
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen38-orchestrator": {
          "id": "qwen3.8-27b",
          "name": "Qwen3.8 V2 Orchestrator 24K",
          "tool_call": true,
