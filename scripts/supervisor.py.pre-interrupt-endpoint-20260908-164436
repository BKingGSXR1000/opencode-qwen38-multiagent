#!/usr/bin/env python3
import base64
import json
import os
import queue
import re
import sqlite3
import ssl
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
from pathlib import Path

ROOT=Path.home()/ "AI/opencode-qwen38-multiagent-v2"
DB=ROOT/"xdg/data/opencode/opencode.db"
LOG=ROOT/"logs/supervisor-events.log"
CSV=ROOT/"logs/supervisor-events.csv"
PROJECT=os.environ.get("V2_PROJECT","")
POLL=1.0

SOFT_SECONDS=60
HARD_SECONDS=120
HARD_REASONING_CHARS=8000

lock=threading.RLock()
events={}
# key=(sessionID,messageID) -> start, reasoning, tool, soft, hard, agent
part_type={}  # partID -> (sessionID,messageID,type)
abort_count={}
retired=set()
continuation_handled=set()
compaction_handled=set()

def log(msg):
    ROOT.joinpath("logs").mkdir(parents=True,exist_ok=True)
    line=f"[{time.strftime('%Y-%m-%dT%H:%M:%S%z')}] {msg}"
    with open(LOG,"a",encoding="utf-8") as f: f.write(line+"\n")
    print(line,file=sys.stderr,flush=True)

def csv(kind,sid="",agent="",detail=""):
    new=not CSV.exists()
    with open(CSV,"a",encoding="utf-8") as f:
        if new: f.write("timestamp,event,session,agent,detail\n")
        detail=detail.replace('"','""')
        f.write(f'{time.strftime("%Y-%m-%dT%H:%M:%S%z")},{kind},{sid},{agent},"{detail}"\n')

def child_info(sid):
    try:
        con=sqlite3.connect(f"file:{DB}?mode=ro",uri=True,timeout=1)
        row=con.execute("SELECT coalesce(agent,''),parent_id FROM session_v2 WHERE id=?",(sid,)).fetchone()
        con.close()
        if not row or row[1] is None: return None
        return row[0]
    except Exception:
        return None

def server_credentials():
    target_cfg=str(ROOT/"xdg/config")
    for proc in Path("/proc").glob("[0-9]*"):
        try:
            pid=int(proc.name)
            cmd=(proc/"cmdline").read_bytes().replace(b"\0",b" ").decode("utf-8","replace")
            if "serve --stdio --port 0" not in cmd:
                continue
            env={}
            for item in (proc/"environ").read_bytes().split(b"\0"):
                if b"=" not in item:
                    continue
                k,v=item.split(b"=",1)
                env[k.decode("utf-8","replace")]=v.decode("utf-8","replace")
            if env.get("XDG_CONFIG_HOME") != target_cfg:
                continue
            password=env.get("OPENCODE_PASSWORD") or env.get("OPENCODE_SERVER_PASSWORD")
            if not password:
                continue
            ssout=subprocess.check_output(["ss","-ltnp"],text=True,stderr=subprocess.DEVNULL)
            port=None
            for line in ssout.splitlines():
                if f"pid={pid}" not in line:
                    continue
                m=re.search(r"127\.0\.0\.1:(\d+)",line)
                if m:
                    port=int(m.group(1)); break
            if port is None:
                continue
            return f"http://127.0.0.1:{port}",password
        except (FileNotFoundError,ProcessLookupError,PermissionError,ValueError,subprocess.SubprocessError):
            continue
        except Exception:
            continue
    return None,None

def auth_header(password):
    token=base64.b64encode(f"opencode:{password}".encode()).decode()
    return f"Basic {token}"

def abort_session(sid,reason):
    url,password=server_credentials()
    if not url:
        log(f"ABORT_FAILED session={sid} reason={reason} no_daemon_registration")
        csv("ABORT_FAILED",sid,child_info(sid) or "",reason)
        return False
    req=urllib.request.Request(
        f"{url}/session/{urllib.parse.quote(sid)}/abort",
        method="POST",
        headers={"Authorization":auth_header(password)}
    )
    try:
        with urllib.request.urlopen(req,timeout=5) as r:
            r.read()
        log(f"ABORT session={sid} agent={child_info(sid) or ''} reason={reason}")
        csv("ABORT",sid,child_info(sid) or "",reason)
        return True
    except Exception as e:
        log(f"ABORT_FAILED session={sid} reason={reason} error={e!r}")
        csv("ABORT_FAILED",sid,child_info(sid) or "",f"{reason}: {e!r}")
        return False

def event_reader():
    while True:
        url,password=server_credentials()
        if not url:
            time.sleep(1); continue

        # Prefer native server event stream; fall back to instance stream.
        paths=["/api/event"]
        if PROJECT:
            paths.append("/event?directory="+urllib.parse.quote(PROJECT,safe=""))
        else:
            paths.append("/event")

        connected=False
        for path in paths:
            try:
                req=urllib.request.Request(
                    url+path,
                    headers={
                        "Authorization":auth_header(password),
                        "Accept":"text/event-stream",
                        "Cache-Control":"no-cache"
                    }
                )
                resp=urllib.request.urlopen(req,timeout=30)
                log(f"SSE_CONNECTED {url+path}")
                csv("SSE_CONNECTED",detail=url+path)
                connected=True
                for raw in resp:
                    line=raw.decode("utf-8","replace").rstrip("\r\n")
                    if not line.startswith("data:"):
                        continue
                    payload=line[5:].strip()
                    if not payload:
                        continue
                    try: obj=json.loads(payload)
                    except Exception: continue
                    handle_event(obj)
                resp.close()
            except Exception as e:
                log(f"SSE_DISCONNECTED path={path} error={e!r}")
                time.sleep(1)
            if connected:
                break
        time.sleep(1)

def props_of(obj):
    typ=obj.get("type")
    props=obj.get("properties")
    if props is None: props=obj.get("data")
    if not isinstance(props,dict): props={}
    return typ,props

def handle_event(obj):
    typ,p=props_of(obj)
    if not typ: return

    # Native /api/event can include location; ignore another project if known.
    loc=obj.get("location")
    if PROJECT and isinstance(loc,dict):
        d=loc.get("directory")
        if d and os.path.realpath(d)!=os.path.realpath(PROJECT):
            return

    if typ=="message.updated":
        info=p.get("info") or p.get("message") or {}
        if not isinstance(info,dict): return
        if info.get("role")!="assistant": return
        sid=p.get("sessionID") or info.get("sessionID")
        mid=info.get("id") or p.get("messageID")
        if not sid or not mid: return
        agent=child_info(sid)
        if not agent: return
        with lock:
            events.setdefault((sid,mid),{
                "start":time.monotonic(),"reasoning":0,"tool":False,
                "soft":False,"hard":False,"agent":agent
            })

    elif typ=="message.part.updated":
        sid=p.get("sessionID")
        part=p.get("part") or {}
        if not sid or not isinstance(part,dict): return
        mid=part.get("messageID")
        pid=part.get("id")
        ptype=part.get("type")
        if not mid or not pid: return
        agent=child_info(sid)
        if not agent: return
        with lock:
            st=events.setdefault((sid,mid),{
                "start":time.monotonic(),"reasoning":0,"tool":False,
                "soft":False,"hard":False,"agent":agent
            })
            part_type[pid]=(sid,mid,ptype)
            if ptype=="tool":
                st["tool"]=True

    elif typ=="message.part.delta":
        sid=p.get("sessionID"); mid=p.get("messageID"); pid=p.get("partID")
        delta=p.get("delta","")
        if not sid or not mid or not pid or not isinstance(delta,str): return
        agent=child_info(sid)
        if not agent: return
        with lock:
            st=events.setdefault((sid,mid),{
                "start":time.monotonic(),"reasoning":0,"tool":False,
                "soft":False,"hard":False,"agent":agent
            })
            pinfo=part_type.get(pid)
            if pinfo and pinfo[2]=="reasoning":
                st["reasoning"] += len(delta)

def timer_loop():
    while True:
        now=time.monotonic()
        to_abort=[]
        with lock:
            for (sid,mid),st in list(events.items()):
                if st["tool"] or st["hard"]:
                    continue
                age=now-st["start"]
                if not st["soft"] and age>=SOFT_SECONDS:
                    st["soft"]=True
                    log(f"SOFT_WARNING session={sid} agent={st['agent']} age={int(age)}s reasoning_chars={st['reasoning']} tools=0")
                    csv("SOFT_WARNING",sid,st["agent"],f"age={int(age)} reasoning={st['reasoning']}")
                if age>=HARD_SECONDS or st["reasoning"]>=HARD_REASONING_CHARS:
                    st["hard"]=True
                    reason=f"runaway age={int(age)}s reasoning_chars={st['reasoning']} tools=0"
                    to_abort.append((sid,st["agent"],reason))
        for sid,agent,reason in to_abort:
            if abort_session(sid,reason):
                with lock:
                    abort_count[sid]=abort_count.get(sid,0)+1
                    if abort_count[sid]>=2:
                        retired.add(sid)
        time.sleep(0.5)

def db_guard_loop():
    while not DB.exists(): time.sleep(1)
    while True:
        try:
            con=sqlite3.connect(str(DB),timeout=1)
            rows=con.execute("""
                SELECT s.id,coalesce(s.agent,''),
                       (SELECT count(*) FROM session_message m
                         WHERE m.session_id=s.id AND m.type='user') AS users,
                       (SELECT count(*) FROM session_message m
                         WHERE m.session_id=s.id AND m.type='compaction') AS comps
                FROM session_v2 s
                WHERE s.parent_id IS NOT NULL
            """).fetchall()
            con.close()

            for sid,agent,users,comps in rows:
                # First compaction retires a child immediately.
                if comps>=1 and sid not in compaction_handled:
                    compaction_handled.add(sid)
                    retired.add(sid)
                    abort_session(sid,f"child_compaction count={comps}; retire child")
                    log(f"RETIRED_COMPACTION session={sid} agent={agent} compactions={comps}")
                    csv("RETIRED_COMPACTION",sid,agent,f"compactions={comps}")

                # A second user message means same-session task_id resume.
                # It is allowed exactly once and only after one runaway abort.
                if users>=2:
                    key=(sid,users)
                    if key in continuation_handled:
                        continue
                    continuation_handled.add(key)

                    allowed=(users==2 and abort_count.get(sid,0)==1 and sid not in retired)
                    if allowed:
                        log(f"RESCUE_ALLOWED session={sid} agent={agent} users={users}")
                        csv("RESCUE_ALLOWED",sid,agent,f"users={users}")
                    else:
                        retired.add(sid)
                        abort_session(sid,f"unauthorized_task_id_reuse users={users} aborts={abort_count.get(sid,0)}")
                        log(f"RETIRED_REUSE session={sid} agent={agent} users={users} aborts={abort_count.get(sid,0)}")
                        csv("RETIRED_REUSE",sid,agent,f"users={users} aborts={abort_count.get(sid,0)}")
        except Exception as e:
            log(f"DB_GUARD_ERROR {e!r}")
        time.sleep(POLL)

def main():
    ROOT.joinpath("logs").mkdir(parents=True,exist_ok=True)
    log(f"SUPERVISOR_START project={PROJECT!r} soft={SOFT_SECONDS}s hard={HARD_SECONDS}s chars={HARD_REASONING_CHARS}")
    threading.Thread(target=event_reader,daemon=True).start()
    threading.Thread(target=timer_loop,daemon=True).start()
    db_guard_loop()

if __name__=="__main__":
    main()
