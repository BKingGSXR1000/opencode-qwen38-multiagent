    "v2noop": {
      "name": "V2 deterministic technical-root no-op",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:57182/v1",
        "apiKey": "v2-noop-local"
      },
      "models": {
        "root-noop": {
          "id": "root-noop",
          "name": "V2 deterministic root no-op",
          "tool_call": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 8192,
            "output": 32
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 2500,
    "reserved": 6000
  },
  "permission": {
    "bash": {
      "*operator-control.py*": "deny",
      "*operator_control.py*": "deny",
      "*git push*": "deny",
      "*git commit*": "deny",
      "*git reset --hard*": "deny"
    },
    "external_directory": {
      "/home/bking/AI/opencode-qwen38-multiagent-v2-a2-v11831/logs/*": "allow",
      "/tmp/*": "allow"
    },
    "question": "deny"
  },
  "subagent_depth": 1
