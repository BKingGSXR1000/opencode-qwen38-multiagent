            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 49152,
            "output": 2048
          },
          "options": {
            "v2_max_tokens": 2048,
            "chat_template_kwargs": {
              "enable_thinking": false,
              "preserve_thinking": false
            }
          }
        },
